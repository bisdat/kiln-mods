<Project Sdk="Kiln.Sdk">
  <PropertyGroup>
    <KilnModId>cross-base-storage</KilnModId>
    <KilnModName>Cross-base Storage (Kiln)</KilnModName>
    <Version>0.1.9</Version>
    <Authors>bisdat</Authors>
    <Description>Final read-only pre-implementation build: complete recipe handoff with validated loaded Magic Chest owner/link snapshots and optional native trace. No remote crafting or inventory mutations.</Description>
    <PackageProjectUrl>https://github.com/bisdat/kiln-mods</PackageProjectUrl>
    <KilnSide>server</KilnSide>
    <KilnClients>none</KilnClients>
    <KilnServices>Items;World;Spawn;Saves;Chat;Gameplay;Rules</KilnServices>
    <KilnGameIds>None</KilnGameIds>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared optional diagnostic formatter; compiles into this mod, no observer dependency. -->
    <Compile Include="../CraftPaymentTrace/TraceReader.cs" Link="NativeRecipeTraceReader.cs" />
  </ItemGroup>
</Project>
