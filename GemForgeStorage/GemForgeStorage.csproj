<Project Sdk="Kiln.Sdk/0.2.0-dev.29.15">
  <PropertyGroup>
    <KilnModId>gemforge-magic-storage</KilnModId>
    <KilnModName>Gem Forge Magic Chest Integration</KilnModName>
    <Version>1.0.0</Version>
    <Authors>bisdat</Authors>
    <Description>Automatically adds same-base Magic Chest gems to the native Gem Forge and pays for upgrades from base storage. No inventory loans.</Description>
    <PackageProjectUrl>https://github.com/bisdat/kiln-mods</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <KilnSide>server</KilnSide>
    <KilnClients>none</KilnClients>
    <KilnServices>Abilities;Stations;Items;Spawn;Players</KilnServices>
    <KilnGameIds>None</KilnGameIds>
  </PropertyGroup>
</Project>
