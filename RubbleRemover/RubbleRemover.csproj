<Project Sdk="Kiln.Sdk/0.2.0-dev.30.6">
  <PropertyGroup>
    <KilnModId>rubble-remover</KilnModId>
    <KilnModName>Rubble Remover</KilnModName>
    <Version>0.1.4</Version>
    <Authors>bisdat</Authors>
    <Description>Craft a safe, terrain-only rubble and mineable-mycelium remover with three brushes.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bisdat/kiln-mods</PackageProjectUrl>
    <KilnSide>both</KilnSide>
    <KilnClients>mod</KilnClients>
    <KilnServices>Blocks;Tools;Content;Chat</KilnServices>
    <!-- Tool brush shape descriptors are world-table declarations read before OnLoad.
         Without baking, the root item stays pending and the Workbench recipe is refused. -->
    <KilnBakeWorldTables>true</KilnBakeWorldTables>
    <KilnGameIds>None</KilnGameIds>
  </PropertyGroup>
  <!-- Native Kiln dev.30.6 read_mod skips toolBrushShapes-only documents.
       A harmless empty blueprints section makes the loader read the baked
       brush definitions. Remove this compatibility shim after upstream fix. -->
  <PropertyGroup>
    <_RubblePython Condition="'$(OS)' == 'Windows_NT'">py -3</_RubblePython>
    <_RubblePython Condition="'$(OS)' != 'Windows_NT'">python3</_RubblePython>
  </PropertyGroup>
  <Target Name="RubbleRemoverWorldTablesCompat" AfterTargets="KilnBake"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(KilnBake)' == 'true'">
    <Exec Command="$(_RubblePython) &quot;$(MSBuildProjectDirectory)/patch-worldtables.py&quot; &quot;$(TargetDir)blocks.tables.json&quot;" />
  </Target>
</Project>
